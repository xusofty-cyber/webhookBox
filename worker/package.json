{
  "name": "hookbox-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute hookbox --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute hookbox --local --file=schema.sql",
    "dev:test": "wrangler dev --port 8787 --var RELAY_TOKEN:testtoken",
    "test:ws": "node test/ws-smoke.mjs",
    "test:gh": "node test/github-signature.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "wrangler": "^3.114.17"
  }
}
